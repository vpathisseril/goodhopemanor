# Copy ONLY to a private environment/secret store. Never commit the real values.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
# REQUIRED on first startup; 14+ characters and not a common password.
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_UNIQUE_RANDOM_PASSWORD
INITIAL_ADMIN_EMAIL=info@goodhopemanor.com
# Production: absolute path on a persistent mounted disk OUTSIDE the app source folder.
# GOODHOPE_DATA_DIR=/mnt/goodhope-private
# DEPLOYMENT_MODE=single-instance
# Production: absolute path to installed, UPDATED ClamAV executable; uploads fail closed if scanner unavailable.
# AV_SCANNER=/usr/bin/clamscan
# Optional email provider: one-time invite links (NOT plaintext passwords)
# EMAIL_PROVIDER=sendgrid
# FROM_EMAIL=info@goodhopemanor.com
# SENDGRID_API_KEY=YOUR_PRIVATE_KEY
